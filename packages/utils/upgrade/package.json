{
  "name": "@skpl/upgrade",
  "version": "5.60.0",
  "description": "CLI to upgrade SKPL applications effortless",
  "keywords": [
    "skpl",
    "package",
    "tool",
    "upgrade",
    "migrate",
    "version"
  ],
  "homepage": "https://github.com/Hutton-h/SKPL-API",
  "bugs": {
    "url": "https://github.com/Hutton-h/SKPL-API/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Hutton-h/SKPL-API.git",
    "directory": "packages/utils/upgrade"
  },
  "license": "SEE LICENSE IN LICENSE",
  "author": {
    "name": "Hutton-h",
    "email": "hutton@skpl.dev",
    "url": "https://github.com/Hutton-h/SKPL-API"
  },
  "maintainers": [
    {
      "name": "Hutton-h",
      "email": "hutton@skpl.dev",
      "url": "https://github.com/Hutton-h/SKPL-API"
    }
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./src/index.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "source": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "bin": "./bin/upgrade.js",
  "files": [
    "bin",
    "dist",
    "resources"
  ],
  "scripts": {
    "build": "run -T npm-run-all clean --parallel build:code build:types",
    "build:code": "run -T rollup -c",
    "build:types": "run -T tsc -p tsconfig.build.json --emitDeclarationOnly",
    "clean": "run -T rimraf ./dist",
    "lint": "run -T eslint . --max-warnings=0",
    "prepublishOnly": "yarn clean && yarn build",
    "test:ts": "run -T tsc -p tsconfig.json",
    "test:unit": "run -T jest",
    "test:unit:watch": "run -T jest --watch",
    "watch": "run -T rollup -c -w"
  },
  "dependencies": {
    "@skpl/utils": "5.60.0",
    "chalk": "4.1.2",
    "cli-table3": "0.6.5",
    "commander": "8.3.0",
    "esbuild-register": "3.6.0",
    "execa": "5.1.1",
    "fast-glob": "3.3.2",
    "fs-extra": "11.3.4",
    "jscodeshift": "17.3.0",
    "lodash": "4.18.1",
    "memfs": "4.68.1",
    "ora": "5.4.1",
    "prompts": "2.4.2",
    "semver": "7.7.4",
    "simple-git": "4.0.2",
    "undici": "8.12.3"
  },
  "devDependencies": {
    "@skpl/types": "5.60.0",
    "@types/fs-extra": "11.0.4",
    "@types/jest": "29.5.2",
    "@types/jscodeshift": "17.3.0",
    "@types/node": "22.20.0",
    "eslint-config-custom": "5.60.0",
    "jest": "29.6.0",
    "rimraf": "6.1.3"
  },
  "engines": {
    "node": ">=22.0.0 <=26.x.x",
    "npm": ">=6.0.0"
  }
}
