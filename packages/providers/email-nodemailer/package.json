{
  "name": "@skpl/provider-email-nodemailer",
  "version": "5.60.0",
  "description": "Nodemailer provider for SKPL",
  "keywords": [
    "skpl",
    "email",
    "provider",
    "nodemailer"
  ],
  "homepage": "https://github.com/Hutton-h/SKPL-API",
  "bugs": {
    "url": "https://github.com/Hutton-h/SKPL-API/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Hutton-h/SKPL-API.git",
    "directory": "packages/providers/email-nodemailer"
  },
  "license": "SEE LICENSE IN LICENSE",
  "author": {
    "name": "Yurii Tykhomyrov"
  },
  "maintainers": [
    {
      "name": "Hutton-h",
      "email": "hutton@skpl.dev",
      "url": "https://github.com/Hutton-h/SKPL-API"
    }
  ],
  "contributors": [
    {
      "name": "Veit Bjarsch",
      "email": "vb@poweruplink.com",
      "url": "https://poweruplink.com"
    },
    {
      "name": "Saunved Mutalik"
    },
    {
      "name": "Robert Schäfer",
      "email": "git@roschaefer.de"
    }
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "source": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.mjs",
      "require": "./dist/utils/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "run -T npm-run-all clean --parallel build:code build:types",
    "build:code": "run -T  rollup -c",
    "build:types": "run -T tsc -p tsconfig.build.json --emitDeclarationOnly",
    "clean": "run -T rimraf ./dist",
    "lint": "run -T eslint . --max-warnings=0",
    "test:ts": "run -T tsc -p tsconfig.json",
    "test:unit:vitest": "vitest run",
    "test:unit:vitest:watch": "vitest --watch",
    "watch": "run -T rollup -c -w"
  },
  "dependencies": {
    "nodemailer": "10.0.9"
  },
  "devDependencies": {
    "@types/node": "22.20.0",
    "eslint-config-custom": "5.60.0",
    "tsconfig": "5.60.0",
    "vitest": "catalog:",
    "vitest-config": "5.60.0"
  },
  "engines": {
    "node": ">=22.0.0 <=26.x.x",
    "npm": ">=6.0.0"
  }
}
