{
  "name": "@skpl/provider-upload-aws-s3",
  "version": "5.60.0",
  "description": "AWS S3 provider for strapi upload",
  "keywords": [
    "upload",
    "aws",
    "s3",
    "skpl"
  ],
  "homepage": "https://github.com/Hutton-h/SKPL-API",
  "bugs": {
    "url": "https://github.com/Hutton-h/SKPL-API/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Hutton-h/SKPL-API.git",
    "directory": "packages/providers/upload-aws-s3"
  },
  "license": "SEE LICENSE IN LICENSE",
  "author": {
    "name": "Hutton-h",
    "email": "hutton@skpl.dev",
    "url": "https://github.com/Hutton-h/SKPL-API"
  },
  "maintainers": [
    {
      "name": "Hutton-h",
      "email": "hutton@skpl.dev",
      "url": "https://github.com/Hutton-h/SKPL-API"
    }
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "source": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "run -T npm-run-all clean --parallel build:code build:types",
    "build:code": "run -T  rollup -c",
    "build:types": "run -T tsc -p tsconfig.build.json --emitDeclarationOnly",
    "clean": "run -T rimraf ./dist",
    "lint": "run -T eslint . --max-warnings=0",
    "test:ts": "run -T tsc -p tsconfig.json",
    "watch": "run -T rollup -c -w",
    "test:unit:vitest": "vitest run",
    "test:unit:vitest:watch": "vitest --watch"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1023.0",
    "@aws-sdk/lib-storage": "3.1023.0",
    "@aws-sdk/s3-request-presigner": "3.1023.0",
    "@aws-sdk/types": "3.973.6",
    "lodash": "4.18.1"
  },
  "devDependencies": {
    "@types/node": "22.20.0",
    "eslint-config-custom": "5.60.0",
    "tsconfig": "5.60.0",
    "vitest": "catalog:",
    "vitest-config": "5.60.0"
  },
  "engines": {
    "node": ">=22.0.0 <=26.x.x",
    "npm": ">=6.0.0"
  }
}
