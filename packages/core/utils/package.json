{
  "name": "@skpl/utils",
  "version": "5.60.0",
  "description": "Shared utilities for the SKPL packages",
  "keywords": [
    "skpl",
    "utils"
  ],
  "homepage": "https://github.com/Hutton-h/SKPL-API",
  "bugs": {
    "url": "https://github.com/Hutton-h/SKPL-API/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Hutton-h/SKPL-API.git",
    "directory": "packages/core/utils"
  },
  "license": "SEE LICENSE IN LICENSE",
  "author": {
    "name": "Hutton-h",
    "email": "hutton@skpl.dev",
    "url": "https://github.com/Hutton-h/SKPL-API"
  },
  "maintainers": [
    {
      "name": "Hutton-h",
      "email": "hutton@skpl.dev",
      "url": "https://github.com/Hutton-h/SKPL-API"
    }
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "source": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "run -T npm-run-all clean --parallel build:code build:types",
    "build:code": "run -T  rollup -c",
    "build:types": "run -T tsc -p tsconfig.build.json --emitDeclarationOnly",
    "clean": "run -T rimraf ./dist",
    "lint": "run -T eslint . --max-warnings=0",
    "test:ts": "run -T tsc -p tsconfig.json",
    "test:unit": "run -T jest",
    "test:unit:watch": "run -T jest --watch",
    "test:unit:vitest": "vitest run",
    "test:unit:vitest:watch": "vitest --watch",
    "watch": "run -T  rollup -c -w"
  },
  "dependencies": {
    "@sindresorhus/slugify": "1.1.0",
    "date-fns": "2.30.0",
    "execa": "5.1.1",
    "http-errors": "2.0.0",
    "lodash": "4.18.1",
    "node-machine-id": "1.1.12",
    "p-map": "4.0.0",
    "preferred-pm": "5.0.0",
    "yup": "0.32.9",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/http-errors": "2.0.4",
    "@types/jest": "29.5.2",
    "@types/koa": "2.15.2",
    "@types/node": "22.20.0",
    "eslint-config-custom": "5.60.0",
    "jest": "29.6.0",
    "koa": "2.16.4",
    "koa-body": "6.0.1",
    "tsconfig": "5.60.0",
    "vitest": "catalog:",
    "vitest-config": "5.60.0"
  },
  "engines": {
    "node": ">=22.0.0 <=26.x.x",
    "npm": ">=6.0.0"
  }
}
