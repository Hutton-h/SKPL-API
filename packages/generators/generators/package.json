{
  "name": "@skpl/generators",
  "version": "5.60.0",
  "description": "Interactive API generator.",
  "keywords": [
    "skpl",
    "generators"
  ],
  "homepage": "https://github.com/Hutton-h/SKPL-API",
  "bugs": {
    "url": "https://github.com/Hutton-h/SKPL-API/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Hutton-h/SKPL-API.git",
    "directory": "packages/generators/generators"
  },
  "license": "SEE LICENSE IN LICENSE",
  "author": {
    "name": "Hutton-h",
    "email": "hutton@skpl.dev",
    "url": "https://github.com/Hutton-h/SKPL-API"
  },
  "maintainers": [
    {
      "name": "Hutton-h",
      "email": "hutton@skpl.dev",
      "url": "https://github.com/Hutton-h/SKPL-API"
    }
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "source": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "run -T npm-run-all clean --parallel build:code build:types",
    "build:code": "run -T run-p build:code:rollup copy-files",
    "build:code:rollup": "run -T rollup -c",
    "build:types": "run -T tsc -p tsconfig.build.json --emitDeclarationOnly",
    "clean": "run -T rimraf ./dist",
    "copy-files": "copyfiles -u 1 -a 'src/templates/**/*' 'src/files/**/*' dist",
    "lint": "run -T eslint . --max-warnings=0",
    "test:ts": "run -T tsc -p tsconfig.json",
    "watch": "run -T rollup -c -w",
    "test:unit:vitest": "run -T nx run generators:build && run -T vitest run",
    "test:unit:vitest:watch": "vitest --watch"
  },
  "dependencies": {
    "@sindresorhus/slugify": "1.1.0",
    "@skpl/typescript-utils": "5.60.0",
    "@skpl/utils": "5.60.0",
    "chalk": "4.1.2",
    "fs-extra": "11.3.4",
    "handlebars": "4.7.10",
    "jscodeshift": "17.3.0",
    "lodash": "4.18.1",
    "plop": "4.0.5",
    "pluralize": "8.0.0"
  },
  "devDependencies": {
    "@types/fs-extra": "11.0.4",
    "@types/jscodeshift": "17.3.0",
    "@types/node": "22.20.0",
    "copyfiles": "2.4.1",
    "eslint-config-custom": "5.60.0",
    "outdent": "^0.8.0",
    "tsconfig": "5.60.0",
    "vitest": "catalog:",
    "vitest-config": "5.60.0"
  },
  "engines": {
    "node": ">=22.0.0 <=26.x.x",
    "npm": ">=6.0.0"
  }
}
