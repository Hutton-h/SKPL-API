{
  "name": "@skpl/plugin-cloud",
  "version": "5.60.0",
  "description": "Instructions to deploy your local project to SKPL Cloud",
  "homepage": "https://github.com/Hutton-h/SKPL-API",
  "bugs": {
    "url": "https://github.com/Hutton-h/SKPL-API/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Hutton-h/SKPL-API.git",
    "directory": "packages/plugins/cloud"
  },
  "license": "MIT",
  "author": {
    "name": "Hutton-h",
    "email": "hutton@skpl.dev",
    "url": "https://github.com/Hutton-h/SKPL-API"
  },
  "maintainers": [
    {
      "name": "Hutton-h",
      "email": "hutton@skpl.dev",
      "url": "https://github.com/Hutton-h/SKPL-API"
    }
  ],
  "exports": {
    "./strapi-admin": {
      "types": "./dist/admin/src/index.d.ts",
      "source": "./admin/src/index.ts",
      "import": "./dist/admin/index.mjs",
      "require": "./dist/admin/index.js",
      "default": "./dist/admin/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "run -T npm-run-all clean --parallel build:code build:types",
    "build:code": "run -T rollup -c",
    "build:types": "run -T run-p build:types:admin",
    "build:types:admin": "run -T tsc -p admin/tsconfig.build.json --emitDeclarationOnly",
    "clean": "run -T rimraf ./dist",
    "develop": "strapi-plugin watch",
    "lint": "run -T eslint . --max-warnings=0",
    "test:ts:front": "run -T tsc -p admin/tsconfig.json",
    "watch": "run -T rollup -c -w"
  },
  "dependencies": {
    "@strapi/design-system": "2.2.4",
    "@strapi/icons": "2.2.4",
    "react-intl": "6.6.2"
  },
  "devDependencies": {
    "@skpl/admin": "5.60.0",
    "@skpl/strapi": "5.60.0",
    "eslint-config-custom": "5.60.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.6",
    "styled-components": "6.4.1",
    "tsconfig": "5.60.0",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@skpl/admin": "^5.0.0",
    "@skpl/strapi": "^5.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-router-dom": "^6.30.3",
    "styled-components": "^6.0.0"
  },
  "engines": {
    "node": ">=22.0.0 <=26.x.x",
    "npm": ">=6.0.0"
  },
  "strapi": {
    "name": "strapi-cloud",
    "description": "Instructions to deploy your local project to Strapi Cloud",
    "kind": "plugin",
    "displayName": "Strapi Cloud"
  }
}
